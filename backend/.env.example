# =============================================================================
# E3SM AI Platform backend configuration
# =============================================================================
# Copy this file to backend/.env for local use only. Never commit credentials.

# =============================================================================
# Response generation and LivAI
# =============================================================================
# Deterministic generation is the default. Set to "livai" only when a key is present.
E3SM_PLATFORM_GENERATOR=deterministic

# LivAI uses an OpenAI-compatible endpoint. Keep the API key local and secret.
E3SM_PLATFORM_LIVAI_API_KEY=
E3SM_PLATFORM_LIVAI_MODEL=gpt-5.5
E3SM_PLATFORM_LIVAI_BASE_URL=https://livai-api.llnl.gov/

# =============================================================================
# API access
# =============================================================================
# Comma-separated browser origins allowed to call the FastAPI backend.
E3SM_PLATFORM_CORS_ALLOW_ORIGINS=http://localhost:5173

# =============================================================================
# Retrieval
# =============================================================================
# Offline-safe lexical retrieval is the default. Semantic and hybrid modes load
# the configured Hugging Face model when the backend service starts.
E3SM_PLATFORM_RETRIEVAL_MODE=lexical
E3SM_PLATFORM_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Lexical gates preserve the deterministic defaults. Semantic scores are cosine
# similarities, not probabilities, and should be calibrated for the selected model.
E3SM_PLATFORM_RETRIEVAL_LEXICAL_MIN_COVERAGE=0.18
E3SM_PLATFORM_RETRIEVAL_LEXICAL_MIN_SCORE=0.11
E3SM_PLATFORM_RETRIEVAL_SEMANTIC_MIN_SCORE=0.7

# Hybrid score is the normalized weighted average of lexical relevance and semantic similarity.
E3SM_PLATFORM_RETRIEVAL_LEXICAL_WEIGHT=0.5
E3SM_PLATFORM_RETRIEVAL_SEMANTIC_WEIGHT=0.5

# =============================================================================
# Observability
# =============================================================================
# Tracing is disabled unless an OTLP HTTP traces endpoint is explicitly set.
# Telemetry service.name for this emitting backend API process.
E3SM_PLATFORM_SERVICE_NAME=e3sm-ai-platform-backend
E3SM_PLATFORM_DEPLOYMENT_ENVIRONMENT=development
E3SM_PLATFORM_OTLP_ENDPOINT=
# Optional comma-separated key=value values. Never log these headers.
E3SM_PLATFORM_OTLP_HEADERS=
