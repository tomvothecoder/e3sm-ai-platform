# Backend-only local prototype configuration. Copy to backend/.env for local use only.
# Never commit a real .env file or real secrets.

# Deterministic generator remains default. Set to "livai" to enable LivAI when a key is present.
ASSISTANT_GENERATOR=deterministic

# LivAI OpenAI-compatible endpoint configuration.
ASSISTANT_LIVAI_API_KEY=
ASSISTANT_LIVAI_MODEL=gpt-5.5
ASSISTANT_LIVAI_BASE_URL=https://livai-api.llnl.gov/

# Comma-separated browser origins allowed to call the FastAPI backend.
E3SM_ASSIST_CORS_ALLOW_ORIGINS=http://localhost:5173

# Tracing is disabled unless an OTLP HTTP traces endpoint is explicitly set.
# Telemetry service.name for this emitting backend API process.
E3SM_ASSIST_SERVICE_NAME=e3sm-assist-api
E3SM_ASSIST_DEPLOYMENT_ENVIRONMENT=development
E3SM_ASSIST_OTLP_ENDPOINT=
# Optional comma-separated key=value values. Never log these headers.
E3SM_ASSIST_OTLP_HEADERS=
